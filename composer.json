{
    "name": "nelexa/roach-php-bundle",
    "description": "Symfony bundle for roach-php/core",
    "type": "symfony-bundle",
    "require": {
        "php": ">= 8.2",
        "roach-php/core": "^3.2",
        "symfony/config": "^7.0|^8.0",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/http-kernel": "^7.0|^8.0",
        "symfony/console": "^7.0|^8.0",
        "symfony/serializer": "^7.0|^8.0"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "symfony/phpunit-bridge": "^7.4|^8.0",
        "symfony/var-dumper": "^7.0|^8.0",
        "symfony/framework-bundle": "^7.0|^8.0",
        "symfony/maker-bundle": "^1.68"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Nelexa\\RoachPhpBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nelexa\\RoachPhpBundle\\Tests\\": "tests/",
            "App\\": "tests/App"
        }
    },
    "authors": [
        {
            "name": "Ne-Lexa",
            "email": "alexey@nelexa.ru"
        }
    ],
    "suggest": {
        "spatie/browsershot": "Required to execute Javascript in spiders"
    }
}
